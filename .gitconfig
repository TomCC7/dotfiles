[user]
	email = cc7@duck.com
	name = cc
[pull]
	rebase = false
	ff = only
[init]
	defaultBranch = main
[credential]
	helper = store
[safe]
	directory = /opt/flutter
	directory = /home/cc/codes/orbslam3_docker/ORB_SLAM3
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[lfs]
	skipdownloaderrors = true
[push]
	autoSetupRemote = true
[credential "https://lfs.dimensionalos.com"]
	helper = "!f() { if [ \"$1\" = \"get\" ]; then echo \"username=token\"; echo \"password=$(gh auth token)\"; fi; }; f"
[credential "https://github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/usr/bin/gh auth git-credential
